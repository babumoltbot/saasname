# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=  # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# AI Provider: "openai" (default) or "anthropic"
AI_PROVIDER=openai

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# WhoisXML API — domain availability (https://domain-availability.whoisxmlapi.com/)
WHOISXML_API_KEY=
# For local testing without API costs, run: node scripts/whoisxml-stub.mjs
# WHOISXML_API_BASE_URL=http://localhost:8765/api/v1

# Domain check mode: "api" (WhoisXML) or "redirect" (link to Porkbun search)
NEXT_PUBLIC_DOMAIN_CHECK_MODE=api

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Audit logs directory (default: ./logs)
AUDIT_LOG_DIR=

# Slack webhook notifications (optional — leave blank to disable)
SLACK_WEBHOOK_HIGH=  # Revenue, errors, new users
SLACK_WEBHOOK_LOW=   # Generations, checkouts, rate limits

# Stripe bypass: when STRIPE_SECRET_KEY is missing, show friendly early access
# message (true) or hard error (false). Default: true.
# STRIPE_BYPASS_ENABLED=true

